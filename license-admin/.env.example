# Firebase web config — copy your real values from Firebase Console >
# Project settings > General > Your apps > SDK setup and configuration.
# These are NOT secret (see README) but are kept out of source control here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# EmailJS — Account > General for the public key, Email Services / Email
# Templates for the other two IDs. The public key is meant to reach the
# browser; restrict abuse via EmailJS's own domain allowlist instead.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
